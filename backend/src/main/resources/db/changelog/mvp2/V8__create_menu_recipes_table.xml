<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="menu_recipes"/>
            </not>
        </preConditions>

        <createTable tableName="menu_recipes">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="menu_recipes_pkey"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>

        <addDefaultValue 
            columnName="id" 
            tableName="menu_recipes"
            defaultValueSequenceNext="menu_recipes_id_seq"/>

        <createSequence 
            sequenceName="menu_recipes_id_seq" 
            startValue="1" 
            incrementBy="1"/>

    </changeSet>

</databaseChangeLog>