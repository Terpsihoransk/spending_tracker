<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="menu_measures"/>
            </not>
        </preConditions>

        <createTable tableName="menu_measures">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="menu_measures_pkey"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="false" unique="true" uniqueConstraintName="menu_measures_code_key"/>
            </column>
        </createTable>

        <addDefaultValue 
            columnName="id" 
            tableName="menu_measures"
            defaultValueSequenceNext="menu_measures_id_seq"/>

        <createSequence 
            sequenceName="menu_measures_id_seq" 
            startValue="1" 
            incrementBy="1"/>

        <insert tableName="menu_measures">
            <column name="code" value="GRAM"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="KG"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="LITER"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="ML"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="PIECE"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="TABLESPOON"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="TEASPOON"/>
        </insert>
        <insert tableName="menu_measures">
            <column name="code" value="CUP"/>
        </insert>

    </changeSet>

</databaseChangeLog>