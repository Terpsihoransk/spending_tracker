<?xml version="1.0" encoding="UTF-8"?>
<!--
    Изолированная конфигурация для проверки GELF-энкодера.
    Повторяет боевую секцию encoder из logback-spring.xml (без Graylog/UDP-транспорта).
-->
<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/gelf-verify.json</file>
        <append>false</append>
        <encoder class="de.siegmar.logbackgelf.GelfEncoder">
            <includeMdcData>true</includeMdcData>
            <includeLevelName>true</includeLevelName>
            <loggerNameKey>logger_name</loggerNameKey>
            <threadNameKey>thread_name</threadNameKey>
            <staticField>app_name:spending-tracker-backend</staticField>
            <staticField>environment:production</staticField>
            <staticField>timezone:Asia/Novosibirsk</staticField>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
